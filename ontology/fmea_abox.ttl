tun:DEF-COR-SPALL-01 a tun:DefectCondition,
        owl:NamedIndividual ;
    rdfs:label "Spalls/delamination with exposed corroded rebar and section loss" ;
    tun:hasCause tun:CAUSE-GW-COR-01 ;
    tun:hasDescription "Concrete spalling and delamination exposing corroded reinforcement with measurable section loss. Spalls and delaminations may occur in concert and are almost always found in association with structural cracks." ;
    tun:hasIndicator tun:IND-COR-REBAR-LOSS-01,
        tun:IND-COR-SPALL-AREA-01,
        tun:IND-COR-SPALL-DEPTH-01,
        tun:IND-COR-SPALL-MOIST-01,
        tun:IND-COR-SPALL-REBAR-CODE-01 ;
    tun:hasMechanism tun:MECH-COR-01 ;
    tun:hasThreshold tun:THRESH-COR-REBAR-30PCT,
        tun:THRESH-COR-SPALL-S2 ;
    tun:locatedAt tun:COMP-LIN-CONC-01 .

tun:DEF-COR-STEEL-PENETRATION-01 a tun:DefectCondition,
        owl:NamedIndividual ;
    rdfs:label "Through-corrosion / holes in liner plates and deformed/corroded flanges" ;
    tun:hasCause tun:CAUSE-COR-STEEL-01 ;
    tun:hasDescription "Penetration of the liner segment due to rusting through; deformed flanges from corrosion or impact; galvanic corrosion at bolted connections caused by dissimilar metal contact" ;
    tun:hasIndicator tun:IND-COR-STEEL-FLANGE-01,
        tun:IND-COR-STEEL-PENETRATION-01 ;
    tun:hasMechanism tun:MECH-COR-02 ;
    tun:hasThreshold tun:THRESH-COR-STEEL-PENETRATION ;
    tun:locatedAt tun:COMP-LIN-STEEL-SEG-01 .

tun:DEF-CRACK-STRUCT-01 a tun:DefectCondition,
        owl:NamedIndividual ;
    rdfs:label "Structural cracks in concrete tunnel liner" ;
    tun:hasCause tun:CAUSE-STRUCT-CRACK-01 ;
    tun:hasDescription "Cracks resulting from structural movement such as settlement. Most common defect found in concrete tunnel liners. Must be distinguished from thermal/shrinkage cracks which should not be structurally rebonded." ;
    tun:hasIndicator tun:IND-CRACK-MOVEMENT-01,
        tun:IND-CRACK-TYPE-01 ;
    tun:hasMechanism tun:MECH-STRUCT-CRACK-01 ;
    tun:hasThreshold tun:THRESH-CRACK-ACTIVE,
        tun:THRESH-CRACK-DORMANT ;
    tun:locatedAt tun:COMP-LIN-CONC-03 .

tun:DEF-HANG-FAIL-01 a tun:DefectCondition,
        owl:NamedIndividual ;
    rdfs:label "Corroded/broken hanger components and failed anchor connections" ;
    tun:hasCause tun:CAUSE-HANG-COR-01 ;
    tun:hasDescription "Broken or damaged hanger rods, clevises, turnbuckles, or connection pins. Failed or loose connections at tunnel arch, particularly adhesive anchors under sustained overhead tension." ;
    tun:hasIndicator tun:IND-HANG-RING-TEST-01,
        tun:IND-HANG-VISUAL-01 ;
    tun:hasMechanism tun:MECH-COR-03 ;
    tun:hasThreshold tun:THRESH-HANG-NO-RING ;
    tun:locatedAt tun:COMP-CEIL-HANG-01 .

tun:DEF-LEAK-CRACK-01 a tun:DefectCondition,
        owl:NamedIndividual ;
    rdfs:label "Leaking cracks and joints in tunnel liner" ;
    tun:hasCause tun:CAUSE-GW-LEAK-01 ;
    tun:hasDescription "Full-depth cracks or failed construction joints allowing groundwater infiltration ranging from surface moisture to continuous flowing water. Uncontrolled and excessive water accelerates corrosion and deterioration of the tunnel liner." ;
    tun:hasIndicator tun:IND-LEAK-CRACK-WIDTH-01,
        tun:IND-LEAK-FLOW-RATE-01,
        tun:IND-LEAK-JOINT-MOVEMENT-01,
        tun:IND-LEAK-MOIST-STATE-01 ;
    tun:hasMechanism tun:MECH-LEAK-01 ;
    tun:hasThreshold tun:THRESH-LEAK-GS,
        tun:THRESH-LEAK-MOVEMENT ;
    tun:locatedAt tun:COMP-LIN-CONC-02 .

tun:DEF-ROCK-FALL-01 a tun:DefectCondition,
        owl:NamedIndividual ;
    rdfs:label "Deteriorated rock reinforcement and falling rock fragments" ;
    tun:hasCause tun:CAUSE-ROCK-DETERIOR-01 ;
    tun:hasDescription "Rock reinforcement elements losing strength due to corrosion, and loose rock fragments falling from tunnel roof and walls onto roadway" ;
    tun:hasIndicator tun:IND-ROCK-LOOSE-01,
        tun:IND-ROCK-REINF-COND-01 ;
    tun:hasMechanism tun:MECH-COR-ROCK-REINF-01 ;
    tun:hasThreshold tun:THRESH-ROCK-LOOSE-PRESENT ;
    tun:locatedAt tun:COMP-ROCK-UNLINED-01 .

