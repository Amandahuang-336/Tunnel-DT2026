std:Clause-AASHTO-DCRT-Ch16-Sections-16-4-1-16-4-5 a std:Clause,
        owl:NamedIndividual ;
    rdfs:label "AASHTO DCRT Ch16 Sections 16.4.1-16.4.5" ;
    std:clauseRef "AASHTO DCRT Ch16 Sections 16.4.1-16.4.5" .

tun:CAUSE-COR-STEEL-01 a tun:PotentialCause,
        owl:NamedIndividual ;
    rdfs:label "Chemical_Exposure" ;
    tun:status "Established" ;
    rdfs:comment "Corrosive tunnel environment causing rusting of steel/cast iron plates. Galvanic corrosion at bolted connections caused by dissimilar metal contact between high-strength bolt and liner plate." .

tun:CAUSE-GW-COR-01 a tun:PotentialCause,
        owl:NamedIndividual ;
    rdfs:label "Groundwater" ;
    tun:status "Established" ;
    rdfs:comment "Groundwater intrusion and moisture (M, GS, F conditions), often with chlorides or carbonation leading to rust, expansion, cracking, delamination, and spalling. Also documented instances from impact, insufficient concrete cover, or poor quality control." .

tun:CAUSE-GW-LEAK-01 a tun:PotentialCause,
        owl:NamedIndividual ;
    rdfs:label "Groundwater" ;
    tun:status "Established" ;
    rdfs:comment "Groundwater pressure acting on tunnel liner through construction joints, failed gaskets, or full-depth structural cracks. Site-specific factors include pH, hardness, chemical composition, and turbidity of groundwater, as well as physical conditions that created the defect, potential for freeze-thaw, and hydrostatic head." .

tun:CAUSE-HANG-COR-01 a tun:PotentialCause,
        owl:NamedIndividual ;
    rdfs:label "Chemical_Exposure" ;
    tun:status "Established" ;
    rdfs:comment "Corrosive tunnel environment degrading steel hanger components. For adhesive (chemical) anchors: potential loss of capacity under sustained tension in overhead applications due to creep, moisture intrusion, or improper installation." .

tun:CAUSE-ROCK-DETERIOR-01 a tun:PotentialCause,
        owl:NamedIndividual ;
    rdfs:label "Chemical_Exposure" ;
    tun:status "Established" ;
    rdfs:comment "Corrosive tunnel environment causing deterioration of rock reinforcement elements. Natural weathering and stress relief causing loosening of rock fragments over time." .

tun:CAUSE-STRUCT-CRACK-01 a tun:PotentialCause,
        owl:NamedIndividual ;
    rdfs:label "Settlement" ;
    tun:status "Probable" ;
    rdfs:comment "Structural stresses not accounted for in the original design, such as differential settlement, structural overload, or ground movement. Distinct from thermal/shrinkage stresses." .

tun:COMP-CEIL-HANG-01 a tun:Structure,
        owl:NamedIndividual ;
    rdfs:label "Ceiling Hangers and Hardware" ;
    rdfs:comment "Steel hanger rods, clevises, turnbuckles, pins, and anchors (cast-in-place inserts or post-installed mechanical/adhesive anchors)" .

tun:COMP-LIN-CONC-01 a tun:Structure,
        owl:NamedIndividual ;
    rdfs:label "Concrete Tunnel Lining" ;
    rdfs:comment "Concrete lining (rebar, embedded steel)" .

tun:COMP-LIN-CONC-02 a tun:Structure,
        owl:NamedIndividual ;
    rdfs:label "Concrete Tunnel Lining - Joints and Cracks" ;
    rdfs:comment "Cast-in-place or precast concrete lining" .

tun:COMP-LIN-CONC-03 a tun:Structure,
        owl:NamedIndividual ;
    rdfs:label "Concrete Tunnel Lining - Structural Cracks" ;
    rdfs:comment "Cast-in-place or precast concrete lining" .

tun:COMP-LIN-STEEL-SEG-01 a tun:Structure,
        owl:NamedIndividual ;
    rdfs:label "Steel/Cast Iron Segmental Liner" ;
    rdfs:comment "Steel or cast-iron segmental lining" .

tun:COMP-ROCK-UNLINED-01 a tun:Structure,
        owl:NamedIndividual ;
    rdfs:label "Unlined Rock Tunnel (rock mass and reinforcement)" ;
    rdfs:comment "Rock reinforcement (rock dowels, rock bolts, cable bolts) with resin or cementitious grout in competent rock" .

tun:Cause-D-0614-L a tun:PotentialCause,
        owl:NamedIndividual ;
    rdfs:label "Historical leak, since addressed" ;
    rdfs:comment "Historical leak, since addressed" .

tun:Cause-D-0756-C a tun:PotentialCause,
        owl:NamedIndividual ;
    rdfs:label "Construction-phase shrinkage (dormant)" ;
    rdfs:comment "Construction-phase shrinkage (dormant)" .

tun:Cause-D-0923-C a tun:PotentialCause,
        owl:NamedIndividual ;
    rdfs:label "Ground movement — active; root cause investigation required" ;
    rdfs:comment "Ground movement — active; root cause investigation required" .

tun:Cause-D-1089-C a tun:PotentialCause,
        owl:NamedIndividual ;
    rdfs:label "Early-age thermal or drying shrinkage" ;
    rdfs:comment "Early-age thermal or drying shrinkage" .

tun:Cause-D-1158-S a tun:PotentialCause,
        owl:NamedIndividual ;
    rdfs:label "Chloride-induced rebar corrosion with section loss" ;
    rdfs:comment "Chloride-induced rebar corrosion with section loss" .

tun:Cause-D-1247-L a tun:PotentialCause,
        owl:NamedIndividual ;
    rdfs:label "Hydrostatic pressure driving water through void behind lining" ;
    rdfs:comment "Hydrostatic pressure driving water through void behind lining" .

tun:Cause-D-1402-L a tun:PotentialCause,
        owl:NamedIndividual ;
    rdfs:label "Joint sealant degradation" ;
    rdfs:comment "Joint sealant degradation" .

tun:IND-COR-SPALL-AREA-01 a tun:MeasuredIndicator,
        owl:NamedIndividual ;
    rdfs:label "Spall surface area" ;
    tun:indicatorType "Dimensional" ;
    tun:unit "sq ft" ;
    rdfs:comment "Visual condition survey with area measurement" .

tun:IND-COR-SPALL-MOIST-01 a tun:MeasuredIndicator,
        owl:NamedIndividual ;
    rdfs:label "Moisture state at defect" ;
    tun:indicatorType "Visual" ;
    tun:unit "categorical" ;
    rdfs:comment "Standardised visual condition survey using US leakage coding system" .

tun:IND-COR-SPALL-REBAR-CODE-01 a tun:MeasuredIndicator,
        owl:NamedIndividual ;
    rdfs:label "Rebar exposure code" ;
    tun:indicatorType "Visual" ;
    tun:unit "categorical" ;
    rdfs:comment "Visual identification of reinforcing steel exposure and estimated section loss percentage" .

tun:IND-COR-STEEL-FLANGE-01 a tun:MeasuredIndicator,
        owl:NamedIndividual ;
    rdfs:label "Flange deformation and corrosion" ;
    tun:indicatorType "Visual" ;
    tun:unit "categorical (deformed/corroded/intact)" ;
    rdfs:comment "Visual inspection of flange condition and bolt connections" .

tun:IND-CRACK-TYPE-01 a tun:MeasuredIndicator,
        owl:NamedIndividual ;
    rdfs:label "Crack type classification" ;
    tun:indicatorType "Visual" ;
    tun:unit "categorical" ;
    rdfs:comment "Engineering assessment to distinguish thermal/shrinkage cracks from structural cracks. Structural analysis of tunnel lining should be performed." .

tun:IND-HANG-VISUAL-01 a tun:MeasuredIndicator,
        owl:NamedIndividual ;
    rdfs:label "Visual condition of hanger components" ;
    tun:indicatorType "Visual" ;
    tun:unit "categorical" ;
    rdfs:comment "Close visual inspection of hanger rod, clevis, turnbuckle, pins, and anchor connection for corrosion, breakage, deformation" .

tun:IND-LEAK-CRACK-WIDTH-01 a tun:MeasuredIndicator,
        owl:NamedIndividual ;
    rdfs:label "Crack width" ;
    tun:indicatorType "Dimensional" ;
    tun:unit "mm or inches" ;
    rdfs:comment "Direct measurement of crack opening" .

tun:IND-LEAK-FLOW-RATE-01 a tun:MeasuredIndicator,
        owl:NamedIndividual ;
    rdfs:label "Water flow volume" ;
    tun:indicatorType "Dimensional" ;
    tun:unit "volume per time (project specific)" ;
    rdfs:comment "Volume measurement required for Flowing (F) classification" .

tun:IND-ROCK-REINF-COND-01 a tun:MeasuredIndicator,
        owl:NamedIndividual ;
    rdfs:label "Rock reinforcement condition" ;
    tun:indicatorType "Visual" ;
    tun:unit "categorical" ;
    rdfs:comment "Visual assessment of bolt heads, plates, and exposed elements for corrosion. Requires engineering geologist or geotechnical engineer with geologic mapping experience." .

tun:INT-COR-CONC-REPAIR-01-Step-01 a tun:InterventionStep,
        owl:NamedIndividual ;
    tun:stepOrder 1 ;
    rdfs:comment "Remove all unsound concrete using chipping hammers (limited to less than 30 lbs including bit to prevent over-excavation of concrete above 4000 psi) or hydro-demolition. Do not use hydro-demolition near electrical equipment, cables, or mechanical equipment." .

tun:INT-COR-CONC-REPAIR-01-Step-02 a tun:InterventionStep,
        owl:NamedIndividual ;
    tun:stepOrder 2 ;
    rdfs:comment "Ensure no feather edges at repair boundaries; maintain vertical shoulder of at least 1/8 inch to prevent spalling at edge of new repair." .

tun:INT-COR-CONC-REPAIR-01-Step-03 a tun:InterventionStep,
        owl:NamedIndividual ;
    tun:stepOrder 3 ;
    rdfs:comment "Seal any leaking cracks or construction joints with chemical grout (single component polyurethane recommended) prior to rebar coating and shotcrete application." .

tun:INT-COR-CONC-REPAIR-01-Step-04 a tun:InterventionStep,
        owl:NamedIndividual ;
    tun:stepOrder 4 ;
    rdfs:comment "Clean all reinforcing steel and exposed structural steel elements to white metal commercial grade." .

tun:INT-COR-CONC-REPAIR-01-Step-05 a tun:InterventionStep,
        owl:NamedIndividual ;
    tun:stepOrder 5 ;
    rdfs:comment "Evaluate rebar for section loss. If loss exceeds 30%, perform structural analysis. If analysis shows inadequate strength, replace damaged bars using mechanical couplers (not lap splices)." .

tun:INT-COR-CONC-REPAIR-01-Step-06 a tun:InterventionStep,
        owl:NamedIndividual ;
    tun:stepOrder 6 ;
    rdfs:comment "Apply zinc-rich coating to cleaned steel within 48 hours of cleaning and not more than 30 days prior to shotcrete application. Zinc-rich preferred over epoxy as it does not form a bond-breaker." .

tun:INT-COR-CONC-REPAIR-01-Step-07 a tun:InterventionStep,
        owl:NamedIndividual ;
    tun:stepOrder 7 ;
    rdfs:comment "For small shallow spalls (< 2 sq ft, S-1): Apply polymer modified hand patch mortar in lifts of 1 to 2 inches, keyed into substrate using J-hooks and welded wire mesh." .

tun:INT-COR-CONC-REPAIR-01-Step-08 a tun:InterventionStep,
        owl:NamedIndividual ;
    tun:stepOrder 8 ;
    rdfs:comment "For larger/deeper repairs (S-2, S-3, S-4): Place hot-dipped galvanized welded wire mesh over repair area to within 2 inches of repair edge, attached to existing rebar and substrate using J-hooks. Use 2x2 inch mesh for dry process shotcrete, 4x4 inch mesh for wet process." .

tun:INT-COR-CONC-REPAIR-01-Step-09 a tun:InterventionStep,
        owl:NamedIndividual ;
    tun:stepOrder 9 ;
    rdfs:comment "Apply polymer modified fibrous shotcrete (wet process for partial tunnel closures due to low dust; dry process only for full closures). Nozzleman and crew must be tested and certified on site mock-ups." .

tun:INT-COR-CONC-REPAIR-01-Step-10 a tun:InterventionStep,
        owl:NamedIndividual ;
    tun:stepOrder 10 ;
    rdfs:comment "Allow shotcrete to cure 20-30 minutes then screed and trowel to desired finish. Do not work surface prematurely. Monitor drying rate as times vary with wind and humidity." .

tun:INT-COR-CONC-REPAIR-01-Step-11 a tun:InterventionStep,
        owl:NamedIndividual ;
    tun:stepOrder 11 ;
    rdfs:comment "Apply curing compound to surface of new shotcrete per manufacturer recommendation to prevent rapid drying." .

tun:INT-COR-STEEL-SEG-01 a tun:Intervention,
        owl:NamedIndividual ;
    rdfs:label "Steel/cast iron segmental liner repair" ;
    tun:hasStep tun:INT-COR-STEEL-SEG-01-Step-01,
        tun:INT-COR-STEEL-SEG-01-Step-02,
        tun:INT-COR-STEEL-SEG-01-Step-03,
        tun:INT-COR-STEEL-SEG-01-Step-04,
        tun:INT-COR-STEEL-SEG-01-Step-05 ;
    tun:sourceReference std:Clause-AASHTO-DCRT-Ch16-Section-16-6-2 ;
    tun:status "Repair" ;
    rdfs:comment "Steel/cast iron segmental liner repair" .

tun:INT-COR-STEEL-SEG-01-Step-01 a tun:InterventionStep,
        owl:NamedIndividual ;
    tun:stepOrder 1 ;
    rdfs:comment "For deformed flanges: reshape flanges with hammers or heat." .

tun:INT-COR-STEEL-SEG-01-Step-02 a tun:InterventionStep,
        owl:NamedIndividual ;
    tun:stepOrder 2 ;
    rdfs:comment "For holes in STEEL segments (post-1923, weldable): weld on a new plate per AWS D1.1 Structural Welding Code." .

tun:INT-COR-STEEL-SEG-01-Step-03 a tun:InterventionStep,
        owl:NamedIndividual ;
    tun:stepOrder 3 ;
    rdfs:comment "For holes in CAST IRON segments (not weldable): braze repair plate to cast iron, OR drill and tap the liner segment and bolt the repair plate to the original segment. Alternative: fill area between flanges with shotcrete." .

tun:INT-COR-STEEL-SEG-01-Step-04 a tun:InterventionStep,
        owl:NamedIndividual ;
    tun:stepOrder 4 ;
    rdfs:comment "For corroded bolted connections with galvanic corrosion: replace entire bolted connection. Install nylon isolation gasket to prevent contact between high-strength bolt and liner plate. Use nylon washers on both sides and plastic sleeve." .

tun:INT-COR-STEEL-SEG-01-Step-05 a tun:InterventionStep,
        owl:NamedIndividual ;
    tun:stepOrder 5 ;
    rdfs:comment "All welded repairs must comply with AWS D1.1/D1.1 Structural Welding Code. All bolted repairs must comply with AASHTO specifications." .

tun:INT-CRACK-REBOND-01-Step-01 a tun:InterventionStep,
        owl:NamedIndividual ;
    tun:stepOrder 1 ;
    rdfs:comment "Confirm crack is dormant (no ongoing movement) through monitoring period." .

tun:INT-CRACK-REBOND-01-Step-02 a tun:InterventionStep,
        owl:NamedIndividual ;
    tun:stepOrder 2 ;
    rdfs:comment "Perform structural analysis to ascertain if crack requires rebonding." .

tun:INT-CRACK-REBOND-01-Step-03 a tun:InterventionStep,
        owl:NamedIndividual ;
    tun:stepOrder 3 ;
    rdfs:comment "Select appropriate resin: Amine or Polyester resin preferred for tunnel work (both unaffected by moisture and bond to surface-saturated concrete). Vinyl ester resin only suitable if crack is completely dry." .

tun:INT-CRACK-REBOND-01-Step-04 a tun:InterventionStep,
        owl:NamedIndividual ;
    tun:stepOrder 4 ;
    rdfs:comment "Install injection ports at approximately 300mm (12 inch) spacing along crack, starting at lower elevation." .

tun:INT-CRACK-REBOND-01-Step-05 a tun:InterventionStep,
        owl:NamedIndividual ;
    tun:stepOrder 5 ;
    rdfs:comment "Seal surface of crack with epoxy sealer between injection ports." .

tun:INT-CRACK-REBOND-01-Step-06 a tun:InterventionStep,
        owl:NamedIndividual ;
    tun:stepOrder 6 ;
    rdfs:comment "Inject resin into lowest port using hydraulic pump until resin appears at next port above." .

tun:INT-CRACK-REBOND-01-Step-07 a tun:InterventionStep,
        owl:NamedIndividual ;
    tun:stepOrder 7 ;
    rdfs:comment "Progress injection upward, filling consecutively to opposite end of crack." .

tun:INT-CRACK-REBOND-01-Step-08 a tun:InterventionStep,
        owl:NamedIndividual ;
    tun:stepOrder 8 ;
    rdfs:comment "Follow manufacturer recommendations, particularly for overhead installations." .

tun:INT-CRACK-REBOND-01-Step-09 a tun:InterventionStep,
        owl:NamedIndividual ;
    tun:stepOrder 9 ;
    rdfs:comment "Cracks with flowing water must be carefully injected per manufacturer guidance." .

tun:INT-HANG-REPAIR-01 a tun:Intervention,
        owl:NamedIndividual ;
    rdfs:label "Ceiling hanger component replacement and anchor remediation" ;
    tun:hasStep tun:INT-HANG-REPAIR-01-Step-01,
        tun:INT-HANG-REPAIR-01-Step-02,
        tun:INT-HANG-REPAIR-01-Step-03,
        tun:INT-HANG-REPAIR-01-Step-04 ;
    tun:sourceReference std:Clause-AASHTO-DCRT-Ch16-Section-16-10-FHWA-Technical-Advisory-2008 ;
    tun:status "Replacement" ;
    rdfs:comment "Ceiling hanger component replacement and anchor remediation" .

tun:INT-HANG-REPAIR-01-Step-01 a tun:InterventionStep,
        owl:NamedIndividual ;
    tun:stepOrder 1 ;
    rdfs:comment "For broken/damaged hanger rod, clevis, turnbuckle, or connection pins: replace with similar components." .

tun:INT-HANG-REPAIR-01-Step-02 a tun:InterventionStep,
        owl:NamedIndividual ;
    tun:stepOrder 2 ;
    rdfs:comment "For failed adhesive (chemical) anchors: replace with undercut mechanical anchors (per FHWA Technical Advisory 2008 which strongly discourages adhesive anchors for permanent sustained tension or overhead applications)." .

tun:INT-HANG-REPAIR-01-Step-03 a tun:InterventionStep,
        owl:NamedIndividual ;
    tun:stepOrder 3 ;
    rdfs:comment "Any use of adhesive anchors must conform to current FHWA directives and other applicable codes and regulations." .

tun:INT-HANG-REPAIR-01-Step-04 a tun:InterventionStep,
        owl:NamedIndividual ;
    tun:stepOrder 4 ;
    rdfs:comment "Verify replacement hanger is in tension using ringing test after installation." .

tun:INT-LEAK-GROUT-01-Step-01 a tun:InterventionStep,
        owl:NamedIndividual ;
    tun:stepOrder 1 ;
    rdfs:comment "Assess site-specific conditions: pH, hardness, chemical composition, turbidity of groundwater; physical conditions of defect; movement potential; water inflow rate." .

tun:INT-LEAK-GROUT-01-Step-02 a tun:InterventionStep,
        owl:NamedIndividual ;
    tun:stepOrder 2 ;
    rdfs:comment "If movement of crack/joint is suspected, monitor the defect for a sufficient period to estimate actual movement." .

tun:INT-LEAK-GROUT-01-Step-03 a tun:InterventionStep,
        owl:NamedIndividual ;
    tun:stepOrder 3 ;
    rdfs:comment "Select grout type based on conditions: (a) For active wet cracks/joints with movement: single component water-reactive polyurethane (hydrophilic if seasonally wet but currently dry; hydrophobic if chemical catalyst preferred). (b) For dry, non-moving defects: epoxy grout for structural rebonding. (c) Particle grouts only for formation grouting outside liner or very large dry cracks." .

tun:INT-LEAK-GROUT-01-Step-04 a tun:InterventionStep,
        owl:NamedIndividual ;
    tun:stepOrder 4 ;
    rdfs:comment "Drill injection holes at 45-degree angle through the defect, spaced alternately on either side at a distance equal to half the thickness of the structural element." .

tun:INT-LEAK-GROUT-01-Step-05 a tun:InterventionStep,
        owl:NamedIndividual ;
    tun:stepOrder 5 ;
    rdfs:comment "Flush all holes with water to clean debris and clean crack/joint sides prior to injection to ensure proper bonding." .

tun:INT-LEAK-GROUT-01-Step-06 a tun:InterventionStep,
        owl:NamedIndividual ;
    tun:stepOrder 6 ;
    rdfs:comment "Install mechanical packers in injection ports." .

tun:INT-LEAK-GROUT-01-Step-07 a tun:InterventionStep,
        owl:NamedIndividual ;
    tun:stepOrder 7 ;
    rdfs:comment "Seal surface of crack with low-modulus gel if crack is actively leaking." .

tun:INT-LEAK-GROUT-01-Step-08 a tun:InterventionStep,
        owl:NamedIndividual ;
    tun:stepOrder 8 ;
    rdfs:comment "Inject grout into lowest mechanical packer using hand-operated hydraulic pump until grout is seen at next injection port up." .

tun:INT-LEAK-GROUT-01-Step-09 a tun:InterventionStep,
        owl:NamedIndividual ;
    tun:stepOrder 9 ;
    rdfs:comment "Repeat process progressively upward until entire crack is injected." .

tun:INT-LEAK-GROUT-01-Step-10 a tun:InterventionStep,
        owl:NamedIndividual ;
    tun:stepOrder 10 ;
    rdfs:comment "Regrouting may be performed up to one week after initial grouting if needed." .

tun:INT-ROCK-REINF-01 a tun:Intervention,
        owl:NamedIndividual ;
    rdfs:label "Rock scaling and reinforcement replacement" ;
    tun:hasStep tun:INT-ROCK-REINF-01-Step-01,
        tun:INT-ROCK-REINF-01-Step-02,
        tun:INT-ROCK-REINF-01-Step-03,
        tun:INT-ROCK-REINF-01-Step-04 ;
    tun:sourceReference std:Clause-AASHTO-DCRT-Ch16-Section-16-9 ;
    tun:status "Rehabilitation" ;
    rdfs:comment "Rock scaling and reinforcement replacement" .

tun:INT-ROCK-REINF-01-Step-01 a tun:InterventionStep,
        owl:NamedIndividual ;
    tun:stepOrder 1 ;
    rdfs:comment "Perform detailed investigation of structural geology by engineering geologist or geotechnical engineer with experience in geologic mapping and rock stability analysis." .

tun:INT-ROCK-REINF-01-Step-02 a tun:InterventionStep,
        owl:NamedIndividual ;
    tun:stepOrder 2 ;
    rdfs:comment "Scale (remove) all loose rock from tunnel roof and walls using backhoe or hoe ram on periodic basis." .

tun:INT-ROCK-REINF-01-Step-03 a tun:InterventionStep,
        owl:NamedIndividual ;
    tun:stepOrder 3 ;
    rdfs:comment "Replace deteriorated rock reinforcement elements (bolts, dowels, cables) with new elements grouted with resin or cementitious grout." .

tun:INT-ROCK-REINF-01-Step-04 a tun:InterventionStep,
        owl:NamedIndividual ;
    tun:stepOrder 4 ;
    rdfs:comment "Alternative containment measures: install steel liner roof as shelter, additional rock bolts with wire mesh to contain falling fragments, or apply shotcrete to areas of concern." .

tun:Indicator-D-0614-L-GPR a tun:MeasuredIndicator,
        owl:NamedIndividual ;
    rdfs:label "GPR indicator for D-0614-L" ;
    tun:atFMEALevel tun:StructureLevel ;
    tun:confidence 0.85 ;
    tun:hasValue "No void, no moisture reflection" ;
    tun:indicatorType "Structure" ;
    tun:isDetectedWith tun:Technique-GPR ;
    tun:unit "m" .

