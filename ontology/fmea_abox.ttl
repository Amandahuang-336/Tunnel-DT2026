    tun:indicatorType "Indicator" ;
    tun:isDetectedWith tun:Technique-RGB ;
    tun:unit "m" .

tun:Indicator-D-0923-C-RGBD a tun:MeasuredIndicator,
        owl:NamedIndividual ;
