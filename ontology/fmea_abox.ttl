    tun:hasValue "Width 0.9mm, length 2.4m" ;
    tun:indicatorType "Indicator" ;
    tun:isDetectedWith tun:Technique-RGBD ;
    tun:unit "mm|m" .

tun:Indicator-D-1089-C-RGB a tun:MeasuredIndicator,
        owl:NamedIndividual ;
    rdfs:label "RGB indicator for D-1089-C" ;
