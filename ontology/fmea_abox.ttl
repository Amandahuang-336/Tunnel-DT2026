    std:clauseRef "AASHTO DCRT Ch16 Section 16.9" .

tun:IND-CRACK-MOVEMENT-01 a tun:MeasuredIndicator,
        owl:NamedIndividual ;
    rdfs:label "Crack movement monitoring" ;
    tun:indicatorType "Deformation" ;
    tun:unit "mm or inches" ;
    rdfs:comment "Crack gages (grid type for visual monitoring or electrical LVDT type for remote/real-time monitoring). Any crack considered for structural rebonding must be monitored to assess if movement is occurring." .

