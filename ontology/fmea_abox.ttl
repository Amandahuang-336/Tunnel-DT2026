        owl:NamedIndividual ;
    rdfs:label "GPR indicator for D-1158-S" ;
    tun:atFMEALevel tun:StructureLevel ;
    tun:confidence 0.82 ;
    tun:hasValue "Rebar cover 28mm (designed 45mm)" ;
    tun:indicatorType "Structure" ;
    tun:isDetectedWith tun:Technique-GPR ;
    tun:unit "mm|m" .

tun:Indicator-D-1158-S-RGB a tun:MeasuredIndicator,
        owl:NamedIndividual ;
    rdfs:label "RGB indicator for D-1158-S" ;
    tun:atFMEALevel tun:MeasuredIndicatorLevel ;
    tun:confidence 0.88 ;
    tun:hasValue "Visible spall, exposed rebar" ;
    tun:indicatorType "Indicator" ;
    tun:isDetectedWith tun:Technique-RGB ;
    tun:unit "categorical" .

tun:Indicator-D-1158-S-RGBD a tun:MeasuredIndicator,
