    tun:operator "=" ;
    tun:prescribesIntervention tun:INT-HANG-REPAIR-01 ;
    tun:sourceReference std:Clause-AASHTO-DCRT-Ch16-Section-16-10 ;
    tun:tier tun:Investigation_Required ;
    tun:unit "acoustic test result" ;
    tun:value "NO_RING (does not ring when struck)" ;
    rdfs:comment "Hangers that exhibit a defect or lack of tension should be closely inspected and checked for structural suitability." .

tun:THRESH-LEAK-MOVEMENT a tun:Threshold,
        owl:NamedIndividual ;
    rdfs:label "Any measurable movement in crack or joint" ;
    tun:derivedFrom std:Clause-AASHTO-DCRT-Ch16-Sections-16-3-2-16-5 ;
    tun:onIndicator tun:IND-LEAK-JOINT-MOVEMENT-01 ;
    tun:operator "exists" ;
    tun:prescribesIntervention tun:INT-LEAK-GROUT-01 ;
    tun:sourceReference std:Clause-AASHTO-DCRT-Ch16-Sections-16-3-2-16-5 ;
    tun:tier tun:Investigation_Required ;
    tun:unit "presence/absence of movement" ;
    tun:value "Any measurable movement in crack or joint" ;
    rdfs:comment "If movement detected: only chemical grout is appropriate (particle grout will fracture and leak will reappear). Structural cracks with settlement that are no longer moving may be structurally rebonded." .

