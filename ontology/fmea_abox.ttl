tun:THRESH-COR-STEEL-PENETRATION a tun:Threshold,
        owl:NamedIndividual ;
    rdfs:label "Any through-corrosion or holes in liner plate" ;
    tun:derivedFrom std:Clause-AASHTO-DCRT-Ch16-Section-16-6-2 ;
    tun:onIndicator tun:IND-COR-STEEL-PENETRATION-01 ;
    tun:operator "exists" ;
    tun:prescribesIntervention tun:INT-COR-STEEL-SEG-01 ;
    tun:sourceReference std:Clause-AASHTO-DCRT-Ch16-Section-16-6-2 ;
    tun:tier tun:Action_Required ;
    tun:unit "presence" ;
    tun:value "Any through-corrosion or holes in liner plate" ;
    rdfs:comment "Repair required: weld new plate (steel post-1923) or braze/bolt repair plate (cast iron)" .

tun:THRESH-HANG-NO-RING a tun:Threshold,
        owl:NamedIndividual ;
    rdfs:label "NO_RING (does not ring when struck)" ;
    tun:derivedFrom std:Clause-AASHTO-DCRT-Ch16-Section-16-10 ;
