    rdfs:label "Liner plate penetration (through-corrosion)" ;
    tun:indicatorType "Visual" ;
    tun:unit "presence/absence, area of section loss" ;
    rdfs:comment "Visual inspection for holes, section loss area estimation" .

tun:IND-HANG-RING-TEST-01 a tun:MeasuredIndicator,
        owl:NamedIndividual ;
    rdfs:label "Hanger ringing test" ;
    tun:indicatorType "Acoustic" ;
    tun:unit "categorical (rings / does not ring)" ;
    rdfs:comment "Strike each hanger with a mason's hammer. A hanger in tension will vibrate or ring like a bell. A hanger not in tension (due to connection or other defect) will not ring." .

tun:IND-LEAK-JOINT-MOVEMENT-01 a tun:MeasuredIndicator,
        owl:NamedIndividual ;
    rdfs:label "Joint/crack movement" ;
    tun:indicatorType "Deformation" ;
    tun:unit "mm or inches" ;
    rdfs:comment "Monitor the defect for a period of time sufficient to allow estimation of actual movement. Crack gages or repeated measurement." .

tun:IND-LEAK-MOIST-STATE-01 a tun:MeasuredIndicator,
        owl:NamedIndividual ;
    rdfs:label "Leakage moisture state" ;
    tun:indicatorType "Visual" ;
    tun:unit "categorical (D/PM/M/GS/F)" ;
    rdfs:comment "Visual condition survey using standardised US leakage coding (Table 16-1)" .

tun:IND-ROCK-LOOSE-01 a tun:MeasuredIndicator,
        owl:NamedIndividual ;
    rdfs:label "Loose rock presence" ;
    tun:indicatorType "Visual" ;
    tun:unit "categorical (present/absent)" ;
    rdfs:comment "Visual inspection and sounding of tunnel roof and walls for loose rock" .

tun:INT-COR-CONC-REPAIR-01 a tun:Intervention,
        owl:NamedIndividual ;
    rdfs:label "Concrete patch repair with rebar treatment and shotcrete" ;
    tun:hasStep tun:INT-COR-CONC-REPAIR-01-Step-01,
        tun:INT-COR-CONC-REPAIR-01-Step-02,
        tun:INT-COR-CONC-REPAIR-01-Step-03,
        tun:INT-COR-CONC-REPAIR-01-Step-04,
        tun:INT-COR-CONC-REPAIR-01-Step-05,
        tun:INT-COR-CONC-REPAIR-01-Step-06,
        tun:INT-COR-CONC-REPAIR-01-Step-07,
        tun:INT-COR-CONC-REPAIR-01-Step-08,
        tun:INT-COR-CONC-REPAIR-01-Step-09,
        tun:INT-COR-CONC-REPAIR-01-Step-10,
        tun:INT-COR-CONC-REPAIR-01-Step-11 ;
    tun:sourceReference std:Clause-AASHTO-DCRT-Ch16-Sections-16-4-1-16-4-5 ;
    tun:status "Repair" ;
    rdfs:comment "Concrete patch repair with rebar treatment and shotcrete" .

tun:INT-CRACK-REBOND-01 a tun:Intervention,
        owl:NamedIndividual ;
    rdfs:label "Structural crack rebonding with epoxy resin injection" ;
    tun:hasStep tun:INT-CRACK-REBOND-01-Step-01,
        tun:INT-CRACK-REBOND-01-Step-02,
        tun:INT-CRACK-REBOND-01-Step-03,
        tun:INT-CRACK-REBOND-01-Step-04,
        tun:INT-CRACK-REBOND-01-Step-05,
        tun:INT-CRACK-REBOND-01-Step-06,
        tun:INT-CRACK-REBOND-01-Step-07,
        tun:INT-CRACK-REBOND-01-Step-08,
        tun:INT-CRACK-REBOND-01-Step-09 ;
    tun:sourceReference std:Clause-AASHTO-DCRT-Ch16-Section-16-5 ;
    tun:status "Repair" ;
    rdfs:comment "Structural crack rebonding with epoxy resin injection" .

tun:INT-LEAK-GROUT-01 a tun:Intervention,
        owl:NamedIndividual ;
    rdfs:label "Chemical grout injection for leak sealing" ;
    tun:hasStep tun:INT-LEAK-GROUT-01-Step-01,
        tun:INT-LEAK-GROUT-01-Step-02,
        tun:INT-LEAK-GROUT-01-Step-03,
        tun:INT-LEAK-GROUT-01-Step-04,
        tun:INT-LEAK-GROUT-01-Step-05,
        tun:INT-LEAK-GROUT-01-Step-06,
        tun:INT-LEAK-GROUT-01-Step-07,
        tun:INT-LEAK-GROUT-01-Step-08,
        tun:INT-LEAK-GROUT-01-Step-09,
        tun:INT-LEAK-GROUT-01-Step-10 ;
    tun:sourceReference std:Clause-AASHTO-DCRT-Ch16-Sections-16-3-1-16-3-2-Table-16-2 ;
    tun:status "Waterproofing_Remediation" ;
    rdfs:comment "Chemical grout injection for leak sealing" .

tun:THRESH-COR-REBAR-30PCT a tun:Threshold,
        owl:NamedIndividual ;
    rdfs:label "> 30%" ;
    tun:derivedFrom std:Clause-AASHTO-DCRT-Ch16-Section-16-4-3 ;
    tun:onIndicator tun:IND-COR-REBAR-LOSS-01 ;
    tun:operator ">" ;
    tun:prescribesIntervention tun:INT-COR-CONC-REPAIR-01 ;
    tun:sourceReference std:Clause-AASHTO-DCRT-Ch16-Section-16-4-3 ;
    tun:tier tun:Action_Required ;
    tun:unit "% rebar section loss" ;
    tun:value 30.0 ;
    rdfs:comment "Structural analysis must be performed. If results indicate inadequate strength with remaining steel, damaged steel must be replaced." .

tun:THRESH-COR-SPALL-S2 a tun:Threshold,
        owl:NamedIndividual ;
    rdfs:label "Spall depth reaching reinforcing steel (S-2 classification)" ;
    tun:derivedFrom std:Clause-AASHTO-DCRT-Ch16-Section-16-4 ;
    tun:onIndicator tun:IND-COR-SPALL-DEPTH-01 ;
    tun:operator "=" ;
    tun:prescribesIntervention tun:INT-COR-CONC-REPAIR-01 ;
    tun:sourceReference std:Clause-AASHTO-DCRT-Ch16-Section-16-4 ;
    tun:tier tun:Action_Required ;
    tun:unit "depth classification" ;
    tun:value "Spall depth reaching reinforcing steel (S-2 classification)" ;
    rdfs:comment "Requires rebar cleaning, coating, and shotcrete/mortar repair with welded wire mesh" .

tun:THRESH-CRACK-ACTIVE a tun:Threshold,
        owl:NamedIndividual ;
    rdfs:label "Any measurable ongoing movement" ;
    tun:derivedFrom std:Clause-AASHTO-DCRT-Ch16-Section-16-5 ;
    tun:onIndicator tun:IND-CRACK-MOVEMENT-01 ;
    tun:operator "exists" ;
    tun:prescribesIntervention tun:INT-CRACK-REBOND-01 ;
    tun:sourceReference std:Clause-AASHTO-DCRT-Ch16-Section-16-5 ;
    tun:tier tun:Investigation_Required ;
    tun:unit "movement status" ;
    tun:value "Any measurable ongoing movement" ;
    rdfs:comment "DO NOT structurally rebond — crack will re-crack. Treat with flexible chemical grout if leaking. Investigate root cause of ongoing movement." .

tun:THRESH-CRACK-DORMANT a tun:Threshold,
        owl:NamedIndividual ;
    rdfs:label "No measurable movement over monitoring period (crack is dormant)" ;
    tun:derivedFrom std:Clause-AASHTO-DCRT-Ch16-Section-16-5 ;
    tun:onIndicator tun:IND-CRACK-MOVEMENT-01 ;
    tun:operator "=" ;
    tun:prescribesIntervention tun:INT-CRACK-REBOND-01 ;
    tun:sourceReference std:Clause-AASHTO-DCRT-Ch16-Section-16-5 ;
    tun:tier tun:Action_Required ;
    tun:unit "movement status" ;
    tun:value "Dormant" ;
    rdfs:comment "Dormant structural crack may be structurally rebonded with epoxy resin injection. A structural analysis of the tunnel lining should be performed to ascertain if rebonding is required." .

tun:THRESH-LEAK-GS a tun:Threshold,
        owl:NamedIndividual ;
    rdfs:label "GS (Glistening Surface) or F (Flowing)" ;
    tun:derivedFrom std:Clause-AASHTO-DCRT-Ch16-Section-16-3 ;
    tun:onIndicator tun:IND-LEAK-MOIST-STATE-01 ;
    tun:operator "in" ;
    tun:prescribesIntervention tun:INT-LEAK-GROUT-01 ;
    tun:sourceReference std:Clause-AASHTO-DCRT-Ch16-Section-16-3 ;
    tun:tier tun:Action_Required ;
    tun:unit "moisture state code" ;
    tun:value "GS|F" ;
    rdfs:comment "Active water ingress requires sealing with chemical grout injection. Grout selection dependent on moisture content, movement potential, and crack width." .

std:Clause-AASHTO-DCRT-Ch16-Section-16-6-2 a std:Clause,
        owl:NamedIndividual ;
    rdfs:label "AASHTO DCRT Ch16 Section 16.6.2" ;
    std:clauseRef "AASHTO DCRT Ch16 Section 16.6.2" .

std:Clause-AASHTO-DCRT-Ch16-Section-16-9 a std:Clause,
