tun:Intervention-D-0614-L a tun:Intervention,
        owl:NamedIndividual ;
    rdfs:label "Case prescription for D-0614-L" ;
    tun:hasStep tun:Intervention-D-0614-L-Step-01 ;
    rdfs:comment "Ordered intervention plan for D-0614-L" .

tun:Intervention-D-0614-L-Step-01 a tun:InterventionStep,
        owl:NamedIndividual ;
    dcterms:source "Maintenance manual" ;
    tun:rationale "Aesthetic only" ;
    tun:stepOrder 1 ;
    rdfs:comment "Cosmetic surface cleaning (pressure wash or chemical)" .

tun:Intervention-D-0756-C a tun:Intervention,
        owl:NamedIndividual ;
    rdfs:label "Case prescription for D-0756-C" ;
    tun:hasStep tun:Intervention-D-0756-C-Step-01,
        tun:Intervention-D-0756-C-Step-02 ;
    rdfs:comment "Ordered intervention plan for D-0756-C" .

tun:Intervention-D-0756-C-Step-01 a tun:InterventionStep,
        owl:NamedIndividual ;
    tun:rationale "Crack is dormant — safe to rebond" ;
    tun:sourceReference std:Clause_16_5_2009 ;
    tun:stepOrder 1 ;
    rdfs:comment "Structural epoxy injection (low pressure)" .

tun:Intervention-D-0756-C-Step-02 a tun:InterventionStep,
        owl:NamedIndividual ;
    dcterms:source "Supplier spec" ;
    tun:rationale "Ensures full penetration" ;
    tun:stepOrder 2 ;
    rdfs:comment "Port injection technique" .

tun:Intervention-D-0923-C a tun:Intervention,
        owl:NamedIndividual ;
    rdfs:label "Case prescription for D-0923-C" ;
    tun:hasStep tun:Intervention-D-0923-C-Step-01,
        tun:Intervention-D-0923-C-Step-02,
        tun:Intervention-D-0923-C-Step-03 ;
    rdfs:comment "Ordered intervention plan for D-0923-C" .

tun:Intervention-D-0923-C-Step-01 a tun:InterventionStep,
        owl:NamedIndividual ;
    tun:rationale "Rebonding causes repair failure" ;
    tun:sourceReference std:Clause_16_5_2009 ;
    tun:stepOrder 1 ;
    rdfs:comment "DO NOT rebond active crack" .

tun:Intervention-D-0923-C-Step-02 a tun:InterventionStep,
        owl:NamedIndividual ;
    tun:rationale "Confirm movement state" ;
    tun:sourceReference std:Clause-AASHTO-Ch15-instrumentation-catalogue ;
    tun:stepOrder 2 ;
    rdfs:comment "Install crack monitoring (grid gauge or LVDT) for 90 days" .

tun:Intervention-D-0923-C-Step-03 a tun:InterventionStep,
        owl:NamedIndividual ;
    tun:rationale "Address cause before structural repair" ;
    tun:sourceReference std:Clause_16_5_2009 ;
    tun:stepOrder 3 ;
    rdfs:comment "Investigate root cause: settlement, overloading, ground movement" .

tun:Intervention-D-1089-C a tun:Intervention,
        owl:NamedIndividual ;
    rdfs:label "Case prescription for D-1089-C" ;
    tun:hasStep tun:Intervention-D-1089-C-Step-01 ;
    rdfs:comment "Ordered intervention plan for D-1089-C" .

tun:Intervention-D-1089-C-Step-01 a tun:InterventionStep,
        owl:NamedIndividual ;
    tun:rationale "Below intervention threshold" ;
    tun:sourceReference std:Clause_AS3600 ;
    tun:stepOrder 1 ;
    rdfs:comment "Record location, monitor in next inspection cycle" .

tun:Intervention-D-1158-S a tun:Intervention,
        owl:NamedIndividual ;
    rdfs:label "Case prescription for D-1158-S" ;
    tun:hasStep tun:Intervention-D-1158-S-Step-01,
        tun:Intervention-D-1158-S-Step-02,
        tun:Intervention-D-1158-S-Step-03,
        tun:Intervention-D-1158-S-Step-04,
        tun:Intervention-D-1158-S-Step-05 ;
    rdfs:comment "Ordered intervention plan for D-1158-S" .

tun:Intervention-D-1158-S-Step-01 a tun:InterventionStep,
        owl:NamedIndividual ;
    tun:rationale "Required by AASHTO §16.4.3 for S-3" ;
    tun:sourceReference std:Clause_16_4_3_2009 ;
    tun:stepOrder 1 ;
    rdfs:comment "Measure actual rebar section loss at repair site" .

tun:Intervention-D-1158-S-Step-02 a tun:InterventionStep,
        owl:NamedIndividual ;
    tun:rationale "May require full segment replacement" ;
    tun:sourceReference std:Clause_16_4_3_2009 ;
    tun:stepOrder 2 ;
    rdfs:comment "If section loss > 30% — structural analysis required" .

tun:Intervention-D-1158-S-Step-03 a tun:InterventionStep,
        owl:NamedIndividual ;
    tun:rationale "Avoid further damage" ;
    tun:sourceReference std:Clause-AASHTO-Ch16-16-4 ;
    tun:stepOrder 3 ;
    rdfs:comment "Remove unsound concrete with chipping hammers <30 lb" .

tun:Intervention-D-1158-S-Step-04 a tun:InterventionStep,
        owl:NamedIndividual ;
    tun:rationale "Corrosion prevention" ;
    tun:sourceReference std:Clause-AASHTO-Ch16-16-4 ;
    tun:stepOrder 4 ;
    rdfs:comment "Clean rebar to white metal, apply zinc coating within 48 hrs" .

tun:Intervention-D-1158-S-Step-05 a tun:InterventionStep,
        owl:NamedIndividual ;
    tun:rationale "Structural requirement for S-3" ;
    tun:sourceReference std:Clause_16_4_3_2009 ;
    tun:stepOrder 5 ;
    rdfs:comment "Rebuild with mechanical couplers — NOT lap splices" .

tun:Intervention-D-1247-L a tun:Intervention,
        owl:NamedIndividual ;
    rdfs:label "Case prescription for D-1247-L" ;
    tun:hasStep tun:Intervention-D-1247-L-Step-01,
        tun:Intervention-D-1247-L-Step-02,
