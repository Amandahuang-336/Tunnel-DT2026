# CQ-10  Is there a previously documented defect at this location?
# Scenario 2: Thermal anomaly triggers investigation of hidden moisture path
# Category: Defect
# Parameters: {RING_ID}
# Defaults:   RING_ID=1247

PREFIX tun:  <http://w3id.org/tunnel-dt/ontology/v1.2#>
PREFIX std:  <http://w3id.org/tunnel-dt/governance#>
PREFIX rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl:  <http://www.w3.org/2002/07/owl#>
PREFIX xsd:  <http://www.w3.org/2001/XMLSchema#>
PREFIX dct:  <http://purl.org/dc/terms/>

SELECT ?defect ?type ?discoveredOn ?description
WHERE {
    ?defect tun:atRingID {RING_ID} ;
            tun:hasType ?type .
    OPTIONAL { ?defect tun:discoveredOn ?discoveredOn . }
    OPTIONAL { ?defect tun:hasDescription ?description . }
}
ORDER BY ?discoveredOn
