# CQ-11  Does the thermal observation provide cause-level evidence for the existing defect?
# Scenario 2: Thermal anomaly triggers investigation of hidden moisture path
# Category: Multimodal
# Parameters: {DEFECT_ID}
# Defaults:   DEFECT_ID=D-1247-L

PREFIX tun:  <http://w3id.org/tunnel-dt/ontology/v1.2#>
PREFIX std:  <http://w3id.org/tunnel-dt/governance#>
PREFIX rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl:  <http://www.w3.org/2002/07/owl#>
PREFIX xsd:  <http://www.w3.org/2001/XMLSchema#>
PREFIX dct:  <http://purl.org/dc/terms/>

SELECT ?indicator ?value ?confidence
       (IF(BOUND(?indicator), "yes", "no") AS ?causeLevelEvidence)
WHERE {
    OPTIONAL {
        tun:{DEFECT_ID} tun:hasIndicator ?indicator .
        ?indicator tun:isDetectedWith tun:Technique-Thermal ;
                   tun:atFMEALevel tun:PotentialCauseLevel ;
                   tun:hasValue ?value .
        OPTIONAL { ?indicator tun:confidence ?confidence . }
    }
}
