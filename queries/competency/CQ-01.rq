# CQ-01  What type of defect has been identified at this location?
# Scenario 1: Crack with moisture detected during quarterly inspection
# Category: Defect
# Parameters: {RING_ID}
# Defaults:   RING_ID=1247

PREFIX tun:  <http://w3id.org/tunnel-dt/ontology/v1.2#>
PREFIX std:  <http://w3id.org/tunnel-dt/governance#>
PREFIX rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl:  <http://www.w3.org/2002/07/owl#>
PREFIX xsd:  <http://www.w3.org/2001/XMLSchema#>
PREFIX dct:  <http://purl.org/dc/terms/>

SELECT ?defect ?defectClass ?description ?position ?chainage
WHERE {
    ?defect tun:atRingID {RING_ID} ;
            tun:hasType ?type .
    BIND(IRI(CONCAT(STR(tun:), ?type)) AS ?defectClass)
    ?defect rdf:type ?defectClass .
    OPTIONAL { ?defect tun:hasDescription ?description . }
    OPTIONAL { ?defect tun:atPosition ?position . }
    OPTIONAL { ?defect tun:atChainage ?chainage . }
}
