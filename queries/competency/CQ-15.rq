# CQ-15  Does the new evidence change the prescribed intervention or its urgency?
# Scenario 2: Thermal anomaly triggers investigation of hidden moisture path
# Category: Maintenance
# Parameters: {DEFECT_ID}
# Defaults:   DEFECT_ID=D-1247-L

PREFIX tun:  <http://w3id.org/tunnel-dt/ontology/v1.2#>
PREFIX std:  <http://w3id.org/tunnel-dt/governance#>
PREFIX rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl:  <http://www.w3.org/2002/07/owl#>
PREFIX xsd:  <http://www.w3.org/2001/XMLSchema#>
PREFIX dct:  <http://purl.org/dc/terms/>

# Intervention steps whose rationale depends on thermal or GPR evidence,
# together with the urgency tier of the activated threshold.
SELECT ?tier ?stepOrder ?step ?rationale
WHERE {
    tun:{DEFECT_ID} tun:hasThreshold ?threshold .
    ?threshold tun:status "Activated" ;
               tun:prescribesIntervention ?intervention .
    OPTIONAL { ?threshold tun:tier ?tier . }
    ?intervention tun:hasStep ?s .
    ?s tun:stepOrder ?stepOrder ;
       rdfs:comment ?step ;
       tun:rationale ?rationale .
    FILTER(REGEX(?rationale, "GPR|thermal|void", "i"))
}
ORDER BY ?stepOrder
