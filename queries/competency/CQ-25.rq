# CQ-25  Which standard clause defines the severity threshold applied?
# Scenario 4: Compliance audit and traceability
# Category: Compliance
# Parameters: {DEFECT_ID}
# Defaults:   DEFECT_ID=D-1158-S

PREFIX tun:  <http://w3id.org/tunnel-dt/ontology/v1.2#>
PREFIX std:  <http://w3id.org/tunnel-dt/governance#>
PREFIX rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl:  <http://www.w3.org/2002/07/owl#>
PREFIX xsd:  <http://www.w3.org/2001/XMLSchema#>
PREFIX dct:  <http://purl.org/dc/terms/>

SELECT ?threshold ?criterion ?clauseRef ?editionName ?textHash
WHERE {
    tun:{DEFECT_ID} tun:hasThreshold ?threshold .
    ?threshold tun:derivedFrom ?clause .
    OPTIONAL { ?threshold rdfs:label ?criterion . }
    ?clause std:clauseRef ?clauseRef ;
            std:inEdition ?edition .
    OPTIONAL { ?clause std:textHash ?textHash . }
    OPTIONAL { ?edition std:edition ?editionName . }
}
