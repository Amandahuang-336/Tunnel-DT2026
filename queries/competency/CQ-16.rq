# CQ-16  Is the rebar cover below the minimum specified in referred Standards for this exposure class?
# Scenario 2: Thermal anomaly triggers investigation of hidden moisture path
# Category: Compliance
# Parameters: {DEFECT_ID}
# Defaults:   DEFECT_ID=D-1158-S

PREFIX tun:  <http://w3id.org/tunnel-dt/ontology/v1.2#>
PREFIX std:  <http://w3id.org/tunnel-dt/governance#>
PREFIX rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl:  <http://www.w3.org/2002/07/owl#>
PREFIX xsd:  <http://www.w3.org/2001/XMLSchema#>
PREFIX dct:  <http://purl.org/dc/terms/>

# Measured and designed cover are read from the GPR finding text
# ("Rebar cover 28mm (designed 45mm)").
SELECT ?finding ?measuredCover_mm ?designCover_mm
       (?measuredCover_mm < ?designCover_mm AS ?belowMinimum)
WHERE {
    tun:{DEFECT_ID} tun:hasIndicator ?i .
    ?i tun:hasValue ?finding .
    FILTER(REGEX(?finding, "cover", "i"))
    BIND(xsd:integer(REPLACE(?finding, "^.*?cover\\s*([0-9]+)\\s*mm.*$", "$1", "i")) AS ?measuredCover_mm)
    BIND(xsd:integer(REPLACE(?finding, "^.*designed\\s*([0-9]+)\\s*mm.*$", "$1", "i")) AS ?designCover_mm)
}
