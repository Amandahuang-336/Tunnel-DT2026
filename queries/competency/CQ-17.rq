# CQ-17  Does the void require a separate intervention (e.g. grout injection)?
# Scenario 2: Thermal anomaly triggers investigation of hidden moisture path
# Category: Maintenance
# Parameters: {DEFECT_ID}
# Defaults:   DEFECT_ID=D-1247-L

PREFIX tun:  <http://w3id.org/tunnel-dt/ontology/v1.2#>
PREFIX std:  <http://w3id.org/tunnel-dt/governance#>
PREFIX rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl:  <http://www.w3.org/2002/07/owl#>
PREFIX xsd:  <http://www.w3.org/2001/XMLSchema#>
PREFIX dct:  <http://purl.org/dc/terms/>

SELECT ?voidEvidence ?stepOrder ?groutStep ?rationale
WHERE {
    tun:{DEFECT_ID} tun:hasIndicator ?gpr .
    ?gpr tun:isDetectedWith tun:Technique-GPR ;
         tun:hasValue ?voidEvidence .
    tun:{DEFECT_ID} tun:hasThreshold/tun:prescribesIntervention ?intervention .
    ?intervention tun:hasStep ?s .
    ?s tun:stepOrder ?stepOrder ;
       rdfs:comment ?groutStep .
    OPTIONAL { ?s tun:rationale ?rationale . }
    FILTER(REGEX(?groutStep, "grout", "i"))
}
ORDER BY ?stepOrder
