# CQ-27  What was the diagnostic completeness at the time of decision?
# Scenario 4: Compliance audit and traceability
# Category: Multimodal
# Parameters: {DEFECT_ID}
# Defaults:   DEFECT_ID=D-1158-S

PREFIX tun:  <http://w3id.org/tunnel-dt/ontology/v1.2#>
PREFIX std:  <http://w3id.org/tunnel-dt/governance#>
PREFIX rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl:  <http://www.w3.org/2002/07/owl#>
PREFIX xsd:  <http://www.w3.org/2001/XMLSchema#>
PREFIX dct:  <http://purl.org/dc/terms/>

SELECT ?decisionBasisDate ?completeness ?tier
       (GROUP_CONCAT(DISTINCT ?technique; separator=", ") AS ?evidenceAtDecision)
WHERE {
    OPTIONAL { tun:{DEFECT_ID} tun:discoveredOn ?decisionBasisDate . }
    OPTIONAL { tun:{DEFECT_ID} tun:completenessScore ?completeness . }
    OPTIONAL {
        tun:{DEFECT_ID} tun:hasThreshold ?t .
        ?t tun:status "Activated" ;
           tun:tier ?tier .
    }
    OPTIONAL { tun:{DEFECT_ID} tun:hasIndicator/tun:isDetectedWith/rdfs:label ?technique . }
}
GROUP BY ?decisionBasisDate ?completeness ?tier
