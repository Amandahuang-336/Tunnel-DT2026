# CQ-19  What is the condition state and diagnostic completeness for each?
# Scenario 3: Prioritisation across multiple defects in a tunnel section
# Category: Defect
# Parameters: {CH_FROM}, {CH_TO}
# Defaults:   CH_FROM=600, CH_TO=1000

PREFIX tun:  <http://w3id.org/tunnel-dt/ontology/v1.2#>
PREFIX std:  <http://w3id.org/tunnel-dt/governance#>
PREFIX rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl:  <http://www.w3.org/2002/07/owl#>
PREFIX xsd:  <http://www.w3.org/2001/XMLSchema#>
PREFIX dct:  <http://purl.org/dc/terms/>

SELECT ?defect ?chainage ?severity ?tier ?completeness
WHERE {
    ?defect tun:atChainage ?chainage .
    OPTIONAL { ?defect tun:hasSeverity ?severity . }
    OPTIONAL { ?defect tun:completenessScore ?completeness . }
    OPTIONAL {
        ?defect tun:hasThreshold ?t .
        ?t tun:status "Activated" ;
           tun:tier ?tier .
    }
    FILTER(?chainage >= {CH_FROM} && ?chainage <= {CH_TO})
}
ORDER BY ?chainage
